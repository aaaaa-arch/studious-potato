{
  "name": "pan-all-in-one",
  "author": "aaaaa-arch",
  "title": "全网盘直链下载器",
  "description": "支持夸克/UC/阿里/百度/迅雷/115/蓝奏/天翼网盘，下载完自动清理转存。配置页独立分组，自动删除默认开启。",
  "icon": "icon.png",
  "version": "2.0.2",
  "homepage": "https://github.com/aaaaa-arch/studious-potato",
  "repository": {
    "url": "https://github.com/aaaaa-arch/studious-potato"
  },
  "scripts": [
    {
      "event": "onResolve",
      "match": {
        "urls": [
          "*://pan.quark.cn/*",
          "*://*.quark.cn/*",
          "*://drive.uc.cn/*",
          "*://*.uc.cn/*",
          "*://www.aliyundrive.com/*",
          "*://*.aliyundrive.com/*",
          "*://pan.baidu.com/*",
          "*://*.baidu.com/*",
          "*://pan.xunlei.com/*",
          "*://115.com/*",
          "*://*.115.com/*",
          "*://*.lanzou.com/*",
          "*://cloud.189.cn/*",
          "*://*.189.cn/*"
        ]
      },
      "entry": "src/index.js"
    },
    {
      "event": "onStart",
      "match": {
        "urls": ["*"]
      },
      "entry": "src/refresh.js"
    },
    {
      "event": "onDone",
      "match": {
        "urls": ["*"]
      },
      "entry": "src/cleanup/cleanup.js"
    },
    {
      "event": "onError",
      "match": {
        "urls": ["*"]
      },
      "entry": "src/cleanup/cleanup.js"
    }
  ],
  "settings": [
    { "name": "quark_enabled",    "title": "启用夸克网盘",        "type": "boolean", "default": true },
    { "name": "quark_cookie",     "title": "夸克网盘 Cookie",     "type": "string",  "default": "" },
    { "name": "quark_autodelete", "title": "夸克自动删除转存",    "type": "boolean", "default": true },
    { "name": "quark_delay",      "title": "夸克删除延迟(秒)",    "type": "number",  "default": 30 },

    { "name": "uc_enabled",       "title": "启用 UC 网盘",         "type": "boolean", "default": true },
    { "name": "uc_cookie",        "title": "UC 网盘 Cookie",       "type": "string",  "default": "" },
    { "name": "uc_autodelete",    "title": "UC 自动删除转存",      "type": "boolean", "default": true },
    { "name": "uc_delay",         "title": "UC 删除延迟(秒)",      "type": "number",  "default": 30 },

    { "name": "aliyun_enabled",    "title": "启用阿里云盘",         "type": "boolean", "default": true },
    { "name": "aliyun_token",      "title": "阿里云盘 Token",       "type": "string",  "default": "" },
    { "name": "aliyun_tokentype",  "title": "Token 类型(refresh/access)", "type": "string",  "default": "refresh" },
    { "name": "aliyun_autodelete", "title": "阿里自动删除转存",     "type": "boolean", "default": true },
    { "name": "aliyun_delay",       "title": "阿里删除延迟(秒)",     "type": "number",  "default": 30 },

    { "name": "baidu_enabled",     "title": "启用百度网盘",         "type": "boolean", "default": true },
    { "name": "baidu_cookie",      "title": "百度网盘 Cookie",      "type": "string",  "default": "" },
    { "name": "baidu_autodelete",  "title": "百度自动删除转存",     "type": "boolean", "default": true },
    { "name": "baidu_delay",       "title": "百度删除延迟(秒)",     "type": "number",  "default": 30 },

    { "name": "xunlei_enabled",     "title": "启用迅雷云盘",         "type": "boolean", "default": true },
    { "name": "xunlei_cookie",      "title": "迅雷云盘 Cookie",      "type": "string",  "default": "" },
    { "name": "xunlei_autodelete",  "title": "迅雷自动删除转存",     "type": "boolean", "default": true },
    { "name": "xunlei_delay",       "title": "迅雷删除延迟(秒)",     "type": "number",  "default": 30 },

    { "name": "pan115_enabled",      "title": "启用 115 网盘",        "type": "boolean", "default": true },
    { "name": "pan115_cookie",       "title": "115 网盘 Cookie",      "type": "string",  "default": "" },
    { "name": "pan115_autodelete",   "title": "115 自动删除转存",     "type": "boolean", "default": true },
    { "name": "pan115_delay",        "title": "115 删除延迟(秒)",     "type": "number",  "default": 30 },

    { "name": "lanzou_enabled",      "title": "启用蓝奏云",           "type": "boolean", "default": true },
    { "name": "lanzou_autodelete",   "title": "蓝奏自动删除(关)",     "type": "boolean", "default": false },

    { "name": "tianyi_enabled",      "title": "启用天翼云盘",         "type": "boolean", "default": true },
    { "name": "tianyi_cookie",       "title": "天翼云盘 Cookie",      "type": "string",  "default": "" },
    { "name": "tianyi_autodelete",   "title": "天翼自动删除转存",     "type": "boolean", "default": true },
    { "name": "tianyi_delay",        "title": "天翼删除延迟(秒)",     "type": "number",  "default": 30 },

    { "name": "debug_log",           "title": "开启调试日志",         "type": "boolean", "default": false },
    { "name": "default_delay",        "title": "全局默认删除延迟(秒)", "type": "number",  "default": 30 }
  ]
}
